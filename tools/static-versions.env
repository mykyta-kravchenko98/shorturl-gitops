# Pinned CI toolchain shared by local development and CI. Keep values without
# a leading "v" so the preflight can compare different output formats.
#
# Helm, kubectl and Terraform accept compatible local versions: their exact
# *_VERSION remains the reproducible CI version, while *_LOCAL_MIN_VERSION and
# *_LOCAL_MAX_VERSION define a half-open local range [min, max). Linters remain
# exact because changing a linter can change the gate result.

HELM_VERSION=3.20.2
HELM_LOCAL_MIN_VERSION=3.20.2
HELM_LOCAL_MAX_VERSION=4.0.0
HELM_UNITTEST_VERSION=1.1.2
KUBECTL_VERSION=1.31.14
KUBECTL_LOCAL_MIN_VERSION=1.30.0
KUBECTL_LOCAL_MAX_VERSION=1.33.0
KUBECONFORM_VERSION=0.8.0

TERRAFORM_VERSION=1.15.8
TERRAFORM_LOCAL_MIN_VERSION=1.7.0
TERRAFORM_LOCAL_MAX_VERSION=2.0.0
TFLINT_VERSION=0.64.0
CHECKOV_VERSION=3.3.8

CONFTEST_VERSION=0.68.2
ACTIONLINT_VERSION=1.7.12
ZIZMOR_VERSION=1.27.0
GITLEAKS_VERSION=8.30.1
JQ_VERSION=1.8.1

YAMLLINT_VERSION=1.38.0
SHELLCHECK_VERSION=0.11.0
MARKDOWNLINT_VERSION=0.49.1
HADOLINT_VERSION=2.15.1
